COHERE_API_KEY=your_cohere_api_key_here
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=truthguard

# Optional — ingestion crawl depth (number of pages to scrape)
MAX_PAGES=400

# Optional — keep a free-tier instance awake via periodic self-ping.
# On Render, RENDER_EXTERNAL_URL is auto-set; only set this to override it.
KEEP_AWAKE_URL=https://your-app.onrender.com
KEEP_AWAKE_INTERVAL=600
